# Copy to `.env` and fill in the token. `.env` is gitignored: the token is a
# secret and must never reach the client bundle, which is why it is read only on
# the server (see server/api/*.post.ts).

# Access token for the Directus user that may CREATE items in the intake
# collection. Prefer a token scoped to create-only on that one collection
# rather than an admin token.
NUXT_DIRECTUS_TOKEN=

# Directus instance and target collection (from the task brief):
#   https://burnes-center.directus.app/items/cw_intake
NUXT_DIRECTUS_URL=https://burnes-center.directus.app
NUXT_INTAKE_COLLECTION=cw_intake
