# Local end-to-end testing against scripts/stub-directus.mjs.
# Committed deliberately: no secret here, and loading this file INSTEAD of
# .env means the real token is not in the process at all, so an accidental
# write to the shared cw_intake collection is impossible.
NUXT_DIRECTUS_URL=http://127.0.0.1:4111
NUXT_DIRECTUS_TOKEN=stub-token-not-a-secret
NUXT_INTAKE_COLLECTION=cw_intake
